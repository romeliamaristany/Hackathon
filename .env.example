# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Better Auth
BETTER_AUTH_SECRET="" # openssl rand -base64 32 (minimo 32 caracteres)
BETTER_AUTH_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3001"
# Credenciales de Google Cloud Console (opcional hasta que existan)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
