// use prisma-8
//
// Las tablas de autenticación (user, session, account, verification) las
// gestiona Better Auth con su propia CLI (npm run auth:migrate), no este
// contrato. `User` se declara aquí como `external` solo para poder referenciarlo
// desde las relaciones: Prisma no emite DDL para esa tabla.

model User {
  id    String @id
  name  String
  email String

  hackathons    Hackathon[]
  participations HackathonParticipant[]

  @@map("user")
  @@control(external)
}

// Resto de tablas de Better Auth: external para que Prisma nunca las modifique.
model Account {
  id String @id

  @@map("account")
  @@control(external)
}

model Session {
  id String @id

  @@map("session")
  @@control(external)
}

model Verification {
  id String @id

  @@map("verification")
  @@control(external)
}

model Hackathon {
  id          Uuid     @id @onCreate(uuid(7))
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @onCreate(now()) @onUpdate(now())

  participants HackathonParticipant[]

  @@index([authorId])
  @@map("hackathon")
}

model HackathonParticipant {
  id          Uuid      @id @onCreate(uuid(7))
  hackathonId Uuid
  userId      String
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt    DateTime  @default(now())

  @@unique([hackathonId, userId])
  @@index([userId])
  @@map("hackathon_participant")
}
